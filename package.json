{
  "name": "web-pulgas-pet",
  "version": "1.0.0",
  "description": "Catálogo web y sistema de orden por WhatsApp para Pulgas Pet",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint frontend/assets/js",
    "lint:fix": "eslint frontend/assets/js --fix",
    "format:check": "prettier --check \"frontend/**/*.{js,css,html}\"",
    "format": "prettier --write \"frontend/**/*.{js,css,html}\"",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5"
  }
}